{
  "name": "stocks-launcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "symbols": "node scripts/build-symbols.mjs",
    "prebuild": "npm run symbols",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:ext": "npm run symbols && tsc --noEmit && vite build -c vite.config.extension.ts && cp public/symbols.json dist-extension/",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
