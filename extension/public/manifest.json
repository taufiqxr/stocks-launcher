{
  "manifest_version": 3,
  "name": "Stocks Launcher",
  "version": "0.1.0",
  "description": "Type a ticker or company name — open Yahoo Finance, Morningstar, Barron's, WSJ and X on its direct quote page, all at once.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stocks Launcher"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "omnibox": {
    "keyword": "sl"
  },
  "permissions": ["storage", "tabGroups"]
}
